# macOS
.DS_Store

# Python
__pycache__/
*.pyc
.venv/
venv/
env/

# Generated analysis outputs are reproducible from `make all` / run_all.sh.
# We keep the code and the vendored master dataset under version control, but
# not the derived CSVs / figures / tables (regenerate them locally).
output/*.csv
output/*.png
output/*.pdf
output/*.xlsx
output/*.docx
output/*.json
# ...except a manifest describing what SHOULD be produced:
!output/EXPECTED_OUTPUTS.md

# Table builders write their .xlsx workbooks into docs/ (see EXPECTED_OUTPUTS.md).
# These are regenerated by `run_all.sh`; only the Markdown docs are tracked.
docs/*.xlsx
docs/*.docx

# Large raw source trees are NOT redistributed (see docs/data_sources.md).
data/raw/

# Dated backups the code/fetch/ builders write before modifying the master.
data/old/
data/*.bak.csv
